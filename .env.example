# --- Connection (standard pg env vars) ---
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=your_password
PGDATABASE=your_database

# --- Docker (optional, for CPU/RAM stats snapshot) ---
DOCKER_CONTAINER=

# --- Benchmark tuning ---
TOP_N_QUERIES=20         # how many queries to pull from pg_stat_statements
MIN_CALLS=5               # ignore queries called fewer times than this (noise filter)
WARMUP_RUNS=10             # discarded runs to warm the buffer cache
MEASURED_RUNS=100          # runs used for percentile calculation
RUN_COLD_CACHE_TEST=false  # if true, restarts the docker container before the FIRST query only (see README)

# --- Custom SQL queries to benchmark ---
CUSTOM_QUERIES=

# --- Optional concurrency sweep ---
# Leave empty to skip. Example: "1,5,10,25,50,100"
CONCURRENCY_LEVELS=
CONCURRENCY_DURATION_SECONDS=5
# Which query to hammer during the concurrency test: "top" (highest total_exec_time) or a literal SQL string
CONCURRENCY_QUERY=top

# --- Output ---
OUTPUT_FILE=benchmark-report.xlsx
